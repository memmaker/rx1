# Light sources. charges = fuel in player turns, omitted = infinite.
# Spawned by spawnLights (game/spawn_rogue.go), not the random item table.
# light_flicker_frame_delay is in milliseconds.

name: torch
internal_name: torch
description: Lights radius 1 and burns 800 turns of fuel. Fuel is not used in lit rooms or in town.
category: light
slot: light_source
charges: 800
light_radius: 1
light_color: 255 223 117
light_flicker_pattern: fire
light_flicker_frame_delay: 125

name: lantern
internal_name: lantern
description: Lights radius 2 and burns 1000 to 1200 turns of fuel. Fuel is not used in lit rooms or in town.
category: light
slot: light_source
charges: 1000-1200
light_radius: 2
light_color: 255 223 117
light_flicker_pattern: fire
light_flicker_frame_delay: 125

