%rec: default

name: monster confusion
internal_name: scroll_monster_confusion
description: Your hands glow red. The next monster you hit becomes confused.
category: scrolls
charges: 1
chance: 8
worth: 140
use_effect: confuse_monster_on_next_attack

name: magic mapping
internal_name: magic_mapping
description: Maps the level and reveals secret doors, but not hidden stairs down.
category: scrolls
charges: 1
chance: 5
worth: 150
use_effect: reveal_map
always_id_on_use: true

name: hold monster
internal_name: hold_monster
description: Freezes every monster you can see. Each has a 1 in 10 chance per turn to break free, about 10 turns on average. Your attacks hit a held monster at +4.
category: scrolls
charges: 1
chance: 2
worth: 180
use_effect: freeze_monsters_in_room

name: charm monster
internal_name: charm_monster
description: Aim it at a monster to make it fight for you for 10 to 20 turns. Undead resist, and others may save.
category: scrolls
charges: 1
chance: 2
worth: 200
zap_effect: charm_target

name: sleep
internal_name: sleep
description: You fall asleep for several turns and are helpless.
category: scrolls
charges: 1
chance: 5
worth: 5
use_effect: fall_asleep
always_id_on_use: true

name: identify
internal_name: identify
description: Pick an item in your pack to identify.
category: scrolls
charges: 1
chance: 21
worth: 100
use_effect: identify_item
always_id_on_use: true

name: scare monster
internal_name: scare_monster
description: Reading it only makes you hear laughter. Dropped, monsters will not step onto it. It turns to dust if picked up twice.
category: scrolls
charges: 1
chance: 4
worth: 200
use_effect: maniacal_laughter

name: food detection
internal_name: food_detection
description: Shows the food lying on the level.
category: scrolls
charges: 1
chance: 4
worth: 60
use_effect: detect_food

name: trap detection
internal_name: trap_detection
description: Reveals the traps on the level for 8 to 15 turns.
category: scrolls
charges: 1
chance: 4
worth: 50
use_effect: detect_traps

name: scroll of teleportation
internal_name: teleportation
description: Teleports you to a random place on the level. Sometimes leaves you confused.
category: scrolls
charges: 1
chance: 7
worth: 165
use_effect: phase_door
always_id_on_use: true

name: enchant weapon
internal_name: enchant_weapon
description: Pick a weapon to enchant. It also lifts a curse from it.
category: scrolls
charges: 1
chance: 10
worth: 150
use_effect: enchant_weapon
always_id_on_use: true

name: enchant armor
internal_name: enchant_armor
description: Pick armor to enchant. It also lifts a curse from it.
category: scrolls
charges: 1
chance: 8
worth: 160
use_effect: enchant_armor
always_id_on_use: true

name: create monster
internal_name: create_monster
description: A monster appears next to you, if there is room.
category: scrolls
charges: 1
chance: 5
worth: 75
use_effect: create_monster
always_id_on_use: true

name: remove curse
internal_name: remove_curse
description: Pick a cursed item to lift its curse.
category: scrolls
charges: 1
chance: 8
use_effect: remove_curse
worth: 105

name: aggravate monsters
internal_name: aggravate_monsters
description: Wakes every monster on the level and sends them after you.
category: scrolls
charges: 1
chance: 1
worth: 20
use_effect: aggravate_monsters
always_id_on_use: true

name: vorpalize weapon
internal_name: vorpalize_weapon
description: Pick a weapon and a monster type. The weapon gets one zap that destroys that monster type outright.
category: scrolls
charges: 1
chance: 1
worth: 300
use_effect: vorpalize
always_id_on_use: true

name: fire wall
internal_name: fire_wall
description: A wave of fire rolls out 4 tiles from you, hurting everything in it for about 8 damage.
category: scrolls
charges: 1
chance: 4
worth: 220
use_effect: fire_wall
always_id_on_use: true

name: genocide
internal_name: genocide
description: Pick a monster type. Every one of them is removed from the dungeon.
category: scrolls
charges: 1
chance: 1
worth: 200
use_effect: genocide
always_id_on_use: true
