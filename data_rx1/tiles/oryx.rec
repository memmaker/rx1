# Oryx Roguelike 2.0 tiles for rx1's tiles theme (themes/tiles.rec), edited with the remapper:
#     remapper data_rx1/tiles/oryx.rec
# icon: cell of oryx.png (mkoryx.py builds it and the font Oryx_Tiles.woff, glyph U+E000+icon); -1 keeps the theme's glyph.
# color: the tile's foreground, a name from the palette (the theme's colors); empty keeps the theme's (or the monster's) colour.

%rec: Tileset
id: oryx
name: Oryx Roguelike 2.0
file: oryx.png
tile_w: 16
tile_h: 24
off_x: 0
off_y: 0
gap_x: 0
gap_y: 0
palette: ../themes/tiles.rec

